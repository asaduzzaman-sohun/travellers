# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters_here
JWT_ISSUER=TourFlowApi
JWT_AUDIENCE=TourFlowApp

# Payment Gateway HMAC Signing Secret (override via PaymentGateway__HmacSecret)
PAYMENT_GATEWAY_HMAC_SECRET=your_payment_gateway_hmac_secret_minimum_32_characters

# Optional Gemini Concierge API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
POSTGRES_DB=tourflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
