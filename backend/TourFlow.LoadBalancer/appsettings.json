{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "signalr-hubs-route": {
        "ClusterId": "tourflow-hub-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set", "For": "Append", "Proto": "Set", "Host": "Set" },
          { "ResponseHeader": "X-LoadBalancer", "Set": "TourFlow-YARP-Hub" }
        ]
      },
      "tourflow-api-route": {
        "ClusterId": "tourflow-api-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          { "X-Forwarded": "Set", "For": "Append", "Proto": "Set", "Host": "Set" },
          { "ResponseHeader": "X-LoadBalancer", "Set": "TourFlow-YARP" },
          { "ResponseHeader": "X-LoadBalancer-Policy", "Set": "AdaptiveLeastRequests" }
        ]
      }
    },
    "Clusters": {
      "tourflow-api-cluster": {
        "LoadBalancingPolicy": "AdaptiveLeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/health/ready",
            "Query": ""
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:20"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        },
        "Destinations": {
          "api-node-1": {
            "Address": "http://localhost:5001"
          },
          "api-node-2": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "tourflow-hub-cluster": {
        "LoadBalancingPolicy": "AdaptiveLeastRequests",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": "TourFlow.Hub.Affinity"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/health/ready",
            "Query": ""
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:20"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "api-node-1": {
            "Address": "http://localhost:5001"
          },
          "api-node-2": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
